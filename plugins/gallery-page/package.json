{
  "name": "gallery-page",
  "version": "1.0.0",
  "description": "아빠의 화단 전체 그림 페이지 — 격자 + 크게 보기(라이트박스)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "quartz": {
    "name": "gallery-page",
    "displayName": "Gallery Page",
    "description": "아빠의 화단 전체 그림 페이지(격자 + 라이트박스) — content/gallery.md 에서만 나온다",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "components": {
      "GalleryGrid": {
        "displayName": "Gallery Grid",
        "defaultPosition": "afterBody",
        "defaultPriority": 5
      }
    }
  }
}
