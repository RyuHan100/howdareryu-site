{
  "name": "climate-timeline",
  "version": "1.0.0",
  "description": "climate histography — 기후 사건 연표. content/timeline/ 에서만 나온다",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "quartz": {
    "name": "climate-timeline",
    "displayName": "Climate Timeline",
    "description": "climate histography — 기후 사건 연표(월 단위 가로 타임라인). content/timeline/ 에서만 나온다",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "components": {
      "ClimateTimeline": {
        "displayName": "Climate Timeline",
        "defaultPosition": "afterBody",
        "defaultPriority": 5
      }
    }
  }
}
