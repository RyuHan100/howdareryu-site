{
  "name": "climate-glossary",
  "version": "1.0.0",
  "description": "climate glossary — 기후 용어집(검색·카테고리 필터). content/glossary.md 에서만 나온다",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
