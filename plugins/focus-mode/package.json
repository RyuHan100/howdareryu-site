{
  "name": "focus-mode",
  "version": "1.0.0",
  "description": "본문만 넓게 보는 집중 모드 토글 — 좌우 sidebar 를 숨기고 본문 폭을 살짝 넓힌다",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "quartz": {
    "name": "focus-mode",
    "displayName": "Focus Mode",
    "description": "본문만 넓게 보는 집중 모드 토글 — 좌우 sidebar 를 숨기고 본문 폭을 살짝 넓힌다",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "components": {
      "FocusModeToggle": {
        "displayName": "Focus Mode Toggle",
        "defaultPosition": "beforeBody",
        "defaultPriority": 1
      }
    }
  }
}
