# translate: true 인 한국어 노트(과 홈)의 영문본 노트.en.md 를 만들어 같은 커밋에 넣는다 — scripts/translate/
# node·claude 는 nvm 에 있어서, 터미널 밖(GUI 등)에서 커밋하면 PATH 에 없을 수 있다.
if ! command -v node >/dev/null 2>&1 || ! command -v claude >/dev/null 2>&1; then
  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
fi
node scripts/translate/pre-commit.mjs
